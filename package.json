{
  "name": "kora-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A little desktop for an ongoing AI worker",
  "main": "dist-node/electron/main.cjs",
  "author": "Kora Worker",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "prestart": "npm run build:node",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build:node": "tsc -p tsconfig.node.json",
    "build": "tsc --noEmit && npm run build:node && vite build --configLoader runner",
    "dist": "npm run build && electron-builder --win portable --x64",
    "test": "npm run build:node && node --test dist-node/electron/*.test.cjs",
    "capture": "npm run build && electron dist-node/scripts/capture.cjs"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "lucide-react": "^0.468.0",
    "openai": "^7.27.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  },
  "build": {
    "appId": "com.kora.worker",
    "productName": "Kora Worker",
    "artifactName": "Kora-Worker-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-node/electron/**/*",
      "!dist-node/electron/**/*.test.*",
      "package.json"
    ],
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "win": {
      "target": "portable",
      "icon": "assets/kora.ico",
      "signExecutable": false
    }
  }
}
